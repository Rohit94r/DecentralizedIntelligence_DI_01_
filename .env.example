# Debug Dojo needs NO environment variables. Everything below is optional.

# Ports
# PORT=3000                 # web app (judges' URL)
# DOJO_API_PORT=4000        # Fastify API (the web app proxies /api/* to it)

# Optional Tier-2 LLM polish for explanations and hints. Without a key the
# deterministic tier is used — the product is complete either way, and any
# LLM text must pass the same prose-only validator + secrecy check.
# ANTHROPIC_API_KEY=
# DOJO_LLM_MODEL=claude-opus-5-5
# DOJO_LLM=off              # force the deterministic tier even if a key is set

# Sandbox tuning
# DOJO_WARM=3               # runner processes kept booted and waiting
# DOJO_MAX_RUNNERS=8        # hard cap on concurrent runner processes
# DOJO_MEM_MB=320           # memory budget per runner above its idle baseline

# Data
# DOJO_DB=apps/api/data/dojo.db
# DOJO_RESEED=1             # re-seed the demo learners at boot
