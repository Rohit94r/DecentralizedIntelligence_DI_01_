# Layerflow needs NO environment variables. Everything below is optional.

# Ports
# PORT=3000                 # web app (judges' URL)
# LAYERFLOW_API_PORT=4000        # Fastify API (the web app proxies /api/* to it)

# Optional Tier-2 LLM polish for explanations and hints. Without a key the
# deterministic tier is used — the product is complete either way, and any
# LLM text must pass the same prose-only validator + secrecy check.
# ANTHROPIC_API_KEY=
# LAYERFLOW_LLM_MODEL=claude-opus-5-5
# LAYERFLOW_LLM=off              # force the deterministic tier even if a key is set

# Sandbox tuning
# LAYERFLOW_WARM=3               # runner processes kept booted and waiting
# LAYERFLOW_MAX_RUNNERS=8        # hard cap on concurrent runner processes
# LAYERFLOW_MEM_MB=320           # memory budget per runner above its idle baseline

# Data
# LAYERFLOW_DB=apps/api/data/layerflow.db
# LAYERFLOW_RESEED=1             # re-seed the demo learners at boot
