# Layerflow needs NO environment variables. Everything below is optional.
# Copy this file to .env (it is git-ignored) and fill in only what you want.

# Ports
# PORT=3000                 # web app (judges' URL)
# LAYERFLOW_API_PORT=4000        # Fastify API (the web app proxies /api/* to it)

# Optional Tier-2 LLM polish for explanations and hints. Without a key the
# deterministic tier is used — the product is complete either way, and any
# LLM text must pass the same prose-only validator + secrecy check.
# ANTHROPIC_API_KEY=
# LAYERFLOW_LLM_MODEL=claude-opus-5-5
# LAYERFLOW_LLM=off              # force the deterministic tier even if a key is set

# ── Mentoring · "Ask Priya" chat · Repo Analyse ─────────────────────────────
# All optional, all have free tiers. With none of them set, Priya still talks
# (built-in replies + your browser's voice) and Repo Analyse still works.
# The first provider that answers wins, in LAYERFLOW_AI_ORDER.
# GROQ_API_KEY=                  # https://console.groq.com/keys  — chat + speech-to-text (Whisper)
# GROQ_MODEL=openai/gpt-oss-120b # falls back to llama-3.3-70b-versatile, then llama-3.1-8b-instant
# GEMINI_API_KEY=                # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.5-flash-lite
# LAYERFLOW_AI_ORDER=groq,gemini,anthropic
# LAYERFLOW_AI=off               # force built-in replies even if keys are set

# Priya's voice (ElevenLabs free tier). Without it, the browser's own voice is used.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_flash_v2_5
# GROQ_STT_MODEL=whisper-large-v3-turbo

# ── Rewards · Bug Bounty · payments ─────────────────────────────────────────
# Streak points and Bug Bounty work with no keys. Dodo Payments is only used for
# the paid Bug Bounty plans companies buy (Starter / Growth). Dodo can't pay
# users out, so cash-outs are paid by an admin over UPI from the /admin page.
# DODO_PAYMENTS_API_KEY=         # https://app.dodopayments.com → Developer → API keys
# DODO_PAYMENTS_ENVIRONMENT=test_mode   # test_mode | live_mode (live = real money; the key must match)
# DODO_PAYMENTS_WEBHOOK_SECRET=  # whsec_… for POST <your-url>/api/payments/dodo/webhook
# DODO_PRODUCT_BOUNTY_STARTER=   # live mode: a one-time ₹1,999 INR product id (pdt_…)
# DODO_PRODUCT_BOUNTY_GROWTH=    # live mode: a one-time ₹4,999 INR product id (pdt_…)
# LAYERFLOW_PAYOUTS=demo         # demo = cash-outs complete in the app with a DEMO reference (no real money)
#                                # manual = they wait on /admin until someone pays over UPI and adds the UTR
# LAYERFLOW_ADMIN_TOKEN=         # protects /admin (cash-outs, goodies, triage). Unset = open demo mode
# LAYERFLOW_TZ_OFFSET_MIN=330    # streak days roll over at local midnight (India = 330)

# Repo Analyse reads public GitHub repos without a token (60 requests/hour).
# A token raises the limit and lets it read private repos the token can see.
# GITHUB_TOKEN=

# Sandbox tuning
# LAYERFLOW_WARM=3               # runner processes kept booted and waiting
# LAYERFLOW_MAX_RUNNERS=8        # hard cap on concurrent runner processes
# LAYERFLOW_MEM_MB=320           # memory budget per runner above its idle baseline

# Data
# LAYERFLOW_DB=apps/api/data/layerflow.db
# LAYERFLOW_RESEED=1             # re-seed the demo learners at boot
