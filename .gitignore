# ---- secrets (NEVER commit these) ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
service-account*.json

# ---- dependencies / builds ----
node_modules/
.pnp
.pnp.js
dist/
build/
.next/
out/
.vercel/
.netlify/
*.tsbuildinfo
next-env.d.ts

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pyodide/

# ---- the system of record (regenerable with `npm run seed`) ----
apps/api/data/*.db
apps/api/data/*.db-wal
apps/api/data/*.db-shm
apps/api/data/*.db-journal

# ---- harness output (regenerable, keeps repo clean) ----
harness/results/
*.log
npm-debug.log*

# ---- os / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.playwright-mcp/
