# ─────────────────────────────────────────────────────────────────────────────
# Debug Dojo — systemd unit
#
#   sudo cp deploy/debug-dojo.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now debug-dojo
#   sudo journalctl -u debug-dojo -f        # follow logs
#
# Why a service and not just `npm start`: an SSH disconnect would kill the
# process, and the judges need the API reachable for the whole judging window.
# `Restart=always` also means a crash comes straight back.
# ─────────────────────────────────────────────────────────────────────────────

[Unit]
Description=Layerflow — website + app API (DI-01 Debug Dojo · Kurukshetra 2026)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/debug-dojo

# ONE server for the website AND the app.
#   website  → Next on PORT (3000)
#   API      → Fastify on LAYERFLOW_API_PORT (4000), localhost only. The website
#              reaches it through Next's /api proxy, the app through nginx's /api/
#              (deploy/nginx.conf) — the API port itself is never public.
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=LAYERFLOW_API_PORT=4000
Environment=LAYERFLOW_API_HOST=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
# Once nginx + HTTPS are in front (needed for the app), keep the website off the
# public internet too — only nginx can reach it. Leave commented while you still
# use http://<vps-ip>:3000 directly.
#Environment=WEB_HOST=127.0.0.1

# ⚠️ LAYERFLOW_RESEED=1 WIPES EVERY LEARNER, POST AND PAYMENT on every restart
# and every deploy. Fine for a judging demo, wrong once real website/app users
# exist — the demo learners are seeded automatically on the very first boot anyway.
#Environment=LAYERFLOW_RESEED=1
# No Free-plan daily caps (the per-device limits in the API still protect the keys).
Environment=LAYERFLOW_LIMITS=off
Environment=LAYERFLOW_CHECKOUT=demo
# Per-device limits (requests per minute from one IP). Judges' test scripts send
# hundreds of submits + hints from ONE laptop, so keep code runs generous while
# judging; AI + voice stay at 60 to protect the Groq / ElevenLabs keys.
Environment=LAYERFLOW_RATE_RUN=600
Environment=LAYERFLOW_RATE_AI=60
# During judging only: lets the Reset button on /judges work. Otherwise a reset
# needs the admin token (LAYERFLOW_ADMIN_TOKEN in .env).
#Environment=LAYERFLOW_ALLOW_RESET=1

# For the app (also settable in .env):
#Environment=LAYERFLOW_PUBLIC_URL=https://your.domain
#Environment=LAYERFLOW_CORS_ORIGINS=https://app.your.domain,capacitor://localhost

# Secrets live in this file only — never in git.
#   chmod 600 /opt/debug-dojo/.env
EnvironmentFile=-/opt/debug-dojo/.env

ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# ── hardening ────────────────────────────────────────────────────────────────
# The sandbox spawns child processes, so we cannot set NoNewPrivileges-free
# sandboxes blindly; these limits keep a runaway runner from eating the box.
MemoryMax=3G
TasksMax=2048
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target